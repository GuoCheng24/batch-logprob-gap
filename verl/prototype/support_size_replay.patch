diff --git a/verl/utils/torch_functional.py b/verl/utils/torch_functional.py
index 490ffc1..128f37f 100644
--- a/verl/utils/torch_functional.py
+++ b/verl/utils/torch_functional.py
@@ -704,6 +704,38 @@ def calculate_sum_pi_squared_from_logits(logits: torch.Tensor):
     return torch.exp(torch.logsumexp(2.0 * logits, dim=-1) - 2.0 * torch.logsumexp(logits, dim=-1))
 
 
+def log_kept_mass_from_logits(logits: torch.Tensor, support_size: torch.Tensor, chunk_size: int = 1024):
+    """
+    Log of the probability mass a truncated sampler kept, from the trainer's own logits.
+
+    top-k, top-p and min-p all keep a prefix of the tokens sorted by probability, so the set the
+    rollout sampled from at a position is the |S| most likely tokens. Given |S| per position, this
+    returns logsumexp(top-|S| logits) - logsumexp(logits). Adding it to a rollout log-prob that was
+    normalised over the kept set puts that log-prob back on the full-vocabulary support.
+
+    Args:
+        logits: Temperature-scaled logits (N, vocab_size).
+        support_size: Kept-set size per position (N,); 0 means no replay there and yields 0.
+        chunk_size: Rows per chunk, to bound the temporary (chunk, vocab_size) buffers.
+
+    Returns:
+        Log kept mass (N,), float32, <= 0.
+    """
+    support_size = support_size.to(device=logits.device, dtype=torch.long)
+    out = torch.zeros(logits.shape[0], dtype=torch.float32, device=logits.device)
+    k_max = min(int(support_size.max().item()), logits.shape[-1]) if support_size.numel() else 0
+    if k_max <= 0:
+        return out
+    for start in range(0, logits.shape[0], chunk_size):
+        chunk = logits[start : start + chunk_size].float()
+        k = support_size[start : start + chunk_size]
+        # logsumexp of the top-k logits for every k up to k_max, then pick each row's own k
+        prefix = torch.logcumsumexp(torch.topk(chunk, k_max, dim=-1).values, dim=-1)
+        kept = prefix.gather(-1, (k.clamp(1, k_max) - 1).unsqueeze(-1)).squeeze(-1) - torch.logsumexp(chunk, dim=-1)
+        out[start : start + chunk_size] = torch.where(k > 0, kept, torch.zeros_like(kept))
+    return out
+
+
 """
 Optimizer related
 """
